generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(255) @unique
  role          String          @db.VarChar(255)
  password      String          @db.VarChar(255)

  rounds        round_players[] @relation(map: "round_players_users_fk")
}

model rounds {
  id            Int             @id @default(autoincrement())
  round_id      String          @db.Uuid @unique
  created_at    DateTime        @default(now())

  players       round_players[] @relation(map: "round_players_rounds_fk")
}

model round_players {
  id            Int             @id @default(autoincrement())
  user_id       Int
  round_id      Int
  score         Int             @default(0)

  user          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "round_players_users_fk")
  round         rounds          @relation(fields: [round_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "round_players_rounds_fk")

  @@unique([user_id, round_id], map: "round_players_user_id_round_id_key")
}
